            or Color3.fromRGB(75, 60, 60)
    end

    refresh()

    button.MouseButton1Click:Connect(function()
        config[key] = not config[key]
        refresh()
    end)
end

-- SLIDERS
local function makeSlider(text, key, minValue, maxValue)
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, -8, 0, 65)
    box.BackgroundColor3 = PANEL
    box.Parent = content

    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(12, 4)
    label.Size = UDim2.new(1, -24, 0, 22)
    label.BackgroundTransparency = 1
    label.TextColor3 = WHITE
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = box

    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(12, 37)
    bar.Size = UDim2.new(1, -24, 0, 7)
    bar.BackgroundColor3 = Color3.fromRGB(65, 47, 47)
    bar.Parent = box

    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = RED
    fill.Parent = bar

    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = WHITE
    knob.Text = ""
    knob.Parent = bar

    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function update(value)
        config[key] = math.clamp(value, minValue, maxValue)

        local alpha = (config[key] - minValue) /
            (maxValue - minValue)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)

        label.Text = text .. ": " .. tostring(
            math.floor(config[key] * 100) / 100
        )
    end

    local active = false

    local function setFromInput(input)
        local alpha = math.clamp(
            (input.Position.X - bar.AbsolutePosition.X) /
            bar.AbsoluteSize.X,
            0,
            1
        )

        update(minValue + alpha * (maxValue - minValue))
    end

    knob.MouseButton1Down:Connect(function()
        active = true
    end)

    UIS.InputChanged:Connect(function(input)
        if active and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromInput(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            active = false
        end
    end)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setFromInput(input)
        end
    end)

    update(config[key])
end

-- ESP DE DEPURAÇÃO
local function removeESP(character)
    if not character then return end

    for _, name in ipairs({
        "FireBRHighlight",
        "FireBRInfo"
    }) do

        local object = character:FindFirstChild(name)

        if object then
            object:Destroy()
        end
    end
end

local function createESP(target)
    local character = target.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")

    if not humanoid or not head then return end

    local highlight = character:FindFirstChild("FireBRHighlight")

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "FireBRHighlight"
        highlight.FillColor = RED
        highlight.OutlineColor = Color3.fromRGB(255, 180, 70)
        highlight.FillTransparency = 0.75

        -- Respeita a visibilidade normal, sem atravessar paredes.
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded

        highlight.Parent = character
    end

    local billboard = character:FindFirstChild("FireBRInfo")

    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "FireBRInfo"
        billboard.Adornee = head
        billboard.Size = UDim2.fromOffset(190, 75)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = false
        billboard.Parent = character

        local function makeLabel(name, y, height)
            local label = Instance.new("TextLabel")
            label.Name = name
            label.Position = UDim2.fromOffset(0, y)
            label.Size = UDim2.new(1, 0, 0, height)
            label.BackgroundTransparency = 1
            label.TextColor3 = WHITE
            label.TextStrokeTransparency = 0.2
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.Parent = billboard

            return label
        end

        makeLabel("Name", 0, 20)
        makeLabel("Item", 20, 20)

        local bg = Instance.new("Frame")
        bg.Name = "HealthBG"
        bg.Position = UDim2.fromOffset(20, 47)
        bg.Size = UDim2.new(1, -40, 0, 9)
        bg.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        bg.BorderSizePixel = 0
        bg.Parent = billboard

        Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Name = "HealthFill"
        fill.Size = UDim2.fromScale(1, 1)
        fill.BackgroundColor3 = Color3.fromRGB(40, 220, 75)
        fill.BorderSizePixel = 0
        fill.Parent = bg

        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    end

    -- NOME
    local nameLabel = billboard:FindFirstChild("Name")
    nameLabel.Visible = config.Names
    nameLabel.Text = target.Name

    -- ITEM LENDÁRIO
    local itemLabel = billboard:FindFirstChild("Item")
    local tool = character:FindFirstChildOfClass("Tool")

    if not config.Items then
        itemLabel.Visible = false

    elseif tool then
        -- A raridade deve estar no atributo String "Rarity" da Tool.
        local rarity = tool:GetAttribute("Rarity")

        local isLegendary =
            rarity == "Legendary"
            or rarity == "Lendário"

        if isLegendary then
            itemLabel.Text = "★ " .. tool.Name .. " [LENDÁRIO]"
            itemLabel.TextColor3 = config.LegendaryColor
            itemLabel.Visible = true

        else
            itemLabel.Visible = not config.LegendaryOnly
            itemLabel.Text = "Item: " .. tool.Name
            itemLabel.TextColor3 = WHITE
        end

    else
        itemLabel.Visible = false
    end

    -- BARRA DE VIDA
    local bg = billboard:FindFirstChild("HealthBG")
    bg.Visible = config.Health

    local fill = bg:FindFirstChild("HealthFill")

    local ratio = math.clamp(
        humanoid.Health / math.max(humanoid.MaxHealth, 1),
        0,
        1
    )

    fill.Size = UDim2.fromScale(ratio, 1)

    if ratio > 0.5 then
        fill.BackgroundColor3 = Color3.fromRGB(40, 220, 75)

    elseif ratio > 0.25 then
        fill.BackgroundColor3 = Color3.fromRGB(255, 190, 30)

    else
        fill.BackgroundColor3 = Color3.fromRGB(255, 55, 55)
    end
end

